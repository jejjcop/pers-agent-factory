{
  "targetRepo": "C:/Per/Projects/stock-panel",
  "baseBranch": "main",
  "worktreeDir": "../.factory-worktrees",
  "setupCommand": "composer install --no-interaction --quiet && npm ci --silent && php -r \"if (file_exists('.env.example') && !file_exists('.env')) { copy('.env.example', '.env'); passthru('php artisan key:generate --quiet'); }\"",
  "testCommand": "php vendor/bin/phpunit --colors=never && node node_modules/@playwright/test/cli.js test --reporter=line",
  "maxParallel": 1,
  "maxBuildAttempts": 3,
  "maxReviewRounds": 2,
  "maxBudgetUsdPerAgent": 2,
  "autoMergeLowRisk": false,
  "highRiskPaths": [
    "data/",
    "deploy/",
    "routes/",
    "config/",
    "database/migrations/",
    "app/Http/Middleware/",
    "app/Providers/",
    "composer.json",
    "composer.lock",
    "package.json",
    "package-lock.json",
    "phpunit.xml",
    "playwright.config.js",
    ".github/",
    ".claude/"
  ],
  "models": {
    "planner": "opus",
    "builder": "sonnet",
    "tester": "sonnet",
    "reviewer": "opus"
  }
}